<section class="ah-root ah-section ah-cta"{% if section.settings.heading != blank %} aria-labelledby="ah-cta-heading-{{ section.id }}"{% endif %}>
  <div class="ah-container">
    <div class="ah-banner ah-cta__banner{% if section.settings.style == 'offer' %} ah-banner--offer{% endif %}">
      {%- if section.settings.show_leaf -%}
        <svg class="ah-banner__leaf" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><path d="M0,100 A100 100 0 0 1 100,0 A100 100 0 0 1 0,100 Z"/></svg>
      {%- endif -%}
      <div class="ah-cta__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ah-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ah-heading ah-heading--section ah-cta__heading" id="ah-cta-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="ah-body">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <div class="ah-banner__actions ah-cta__actions">
          <a class="ah-btn ah-btn--ink" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .ah-cta .ah-banner { display: flex; flex-direction: column; gap: var(--ah-space-6); margin: 0; padding: calc(var(--ah-space-4) * 2) var(--ah-space-6); }
  .ah-cta .ah-cta__content { position: relative; display: flex; flex-direction: column; gap: calc(var(--ah-space-2) * 1.5); min-width: 0; }
  .ah-cta .ah-cta__content > * { margin: 0; }
  .ah-cta .ah-banner .ah-heading { max-width: none; font-weight: 800; }
  .ah-cta .ah-banner .ah-body { max-width: none; }
  .ah-cta .ah-banner__actions { margin-top: 0; }
  .ah-cta .ah-banner__actions .ah-btn { width: 100%; }

  @media (min-width: 750px) {
    .ah-cta .ah-banner { flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--ah-space-6) var(--ah-space-12); padding: calc(var(--ah-space-4) * 4); }
    .ah-cta .ah-cta__content { flex: 1 1 420px; }
    .ah-cta .ah-banner .ah-heading { font-size: 40px; line-height: 46px; letter-spacing: -0.02em; }
    .ah-cta .ah-banner__actions .ah-btn { width: auto; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AH CTA banner",
  "tag": "div",
  "class": "ah-section-cta-banner",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "info": "Lime for brand or category pushes. Orange for time-limited offers only.",
      "default": "accent",
      "options": [
        { "value": "accent", "label": "Lime" },
        { "value": "offer", "label": "Orange (offer)" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_leaf",
      "label": "Show leaf motif",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Refill offer"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "15% off your first refill pack."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "info": "For offers, include the code and the end date.",
      "default": "Use code REFILL15 at checkout. Valid till 30 November 2026."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop refills"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "AH CTA banner"
    }
  ]
}
{% endschema %}
