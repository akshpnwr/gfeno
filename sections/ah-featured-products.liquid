{%- if section.settings.show_add_to_cart -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign collection = section.settings.collection
  assign bestseller_handle = section.settings.bestseller_collection.handle
-%}
<section class="ah-root ah-section ah-featured-products"{% if section.settings.heading != blank %} aria-labelledby="ah-fp-heading-{{ section.id }}"{% endif %}>
  <div class="ah-container">
    {%- assign heading_id = 'ah-fp-heading-' | append: section.id -%}
    {%- render 'ah-section-head',
      heading: section.settings.heading,
      heading_id: heading_id,
      link_label: section.settings.link_label,
      link_url: section.settings.link_url
    -%}
    <ul class="ah-featured-products__grid" role="list">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <li>
            {%- render 'ah-product-card',
              product: product,
              section_id: section.id,
              show_rating: section.settings.show_rating,
              show_add_to_cart: section.settings.show_add_to_cart,
              bestseller_handle: bestseller_handle,
              sale_label: section.settings.sale_label,
              new_label: section.settings.new_label,
              bestseller_label: section.settings.bestseller_label,
              sizes: '(min-width: 1280px) 290px, (min-width: 750px) 25vw, 50vw'
            -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          <li>
            <div class="ah-card">
              <div class="ah-card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'ah-placeholder' }}</div>
              <div class="ah-card__body">
                <h3 class="ah-card__title">{{ 'onboarding.product_title' | t }}</h3>
              </div>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .ah-featured-products__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--ah-space-4); margin: 0; padding: 0; list-style: none; }
  @media (min-width: 750px) {
    .ah-featured-products__grid { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--ah-space-6); }
  }
  @media (min-width: 990px) {
    .ah-featured-products__grid { grid-template-columns: repeat(4, 1fr); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AH Featured products",
  "tag": "div",
  "class": "ah-section-featured-products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop bestsellers"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "info": "Needs a reviews app that writes product rating metafields.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show add to cart",
      "info": "Products with options show a link to the product page instead.",
      "default": true
    },
    {
      "type": "header",
      "content": "Badges"
    },
    {
      "type": "text",
      "id": "sale_label",
      "label": "Sale badge",
      "info": "[percent] is replaced with the discount. Leave blank to hide.",
      "default": "[percent]% off"
    },
    {
      "type": "text",
      "id": "new_label",
      "label": "New badge",
      "info": "Shown on products tagged \"new\". Leave blank to hide.",
      "default": "New"
    },
    {
      "type": "text",
      "id": "bestseller_label",
      "label": "Bestseller badge",
      "info": "Shown on products in the bestseller collection. Leave blank to hide.",
      "default": "Bestseller"
    },
    {
      "type": "collection",
      "id": "bestseller_collection",
      "label": "Bestseller collection"
    }
  ],
  "presets": [
    {
      "name": "AH Featured products"
    }
  ]
}
{% endschema %}
