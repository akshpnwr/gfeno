<section class="ah-root ah-hero" aria-labelledby="ah-hero-heading-{{ section.id }}">
  <div class="ah-container">
    <div class="ah-hero__panel ah-scheme color-{{ section.settings.color_scheme }}">
      {%- if section.settings.show_leaf -%}
        <svg class="ah-hero__leaf" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><path d="M10 90 C10 40 40 10 90 10 C90 60 60 90 10 90 Z"/></svg>
      {%- endif -%}
      <div class="ah-hero__content">
        {%- if section.settings.tag != blank -%}
          <span class="ah-tag ah-tag--label ah-hero__tag">{{ section.settings.tag | escape }}</span>
        {%- endif -%}
        <h1 class="ah-heading ah-hero__heading" id="ah-hero-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
        {%- if section.settings.text != blank -%}
          <p class="ah-body ah-hero__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
          <div class="ah-hero__actions">
            {%- if section.settings.button_label_1 != blank -%}
              <a class="ah-btn ah-btn--primary" href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}">{{ section.settings.button_label_1 | escape }}</a>
            {%- endif -%}
            {%- if section.settings.button_label_2 != blank -%}
              <a class="ah-btn ah-btn--outline" href="{{ section.settings.button_link_2 | default: routes.all_products_collection_url }}">{{ section.settings.button_label_2 | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      <div class="ah-hero__media">
        {%- render 'ah-image',
          image: section.settings.image,
          alt: section.settings.image_alt,
          sizes: '(min-width: 1280px) 560px, (min-width: 750px) 45vw, calc(100vw - 64px)',
          eager: true,
          placeholder: 'lifestyle-1'
        -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .ah-hero { padding-top: var(--ah-space-6); }
  .ah-hero__panel {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--ah-space-4) * 2);
    align-items: center;
    padding: var(--ah-space-6);
    border-radius: var(--ah-radius-md);
  }
  .ah-hero__leaf { position: absolute; right: -60px; top: -70px; width: 200px; height: 200px; fill: var(--ah-accent); opacity: .9; pointer-events: none; }
  .ah-hero__content { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: var(--ah-space-4); min-width: 0; }
  .ah-hero .ah-hero__heading { font-size: 40px; line-height: 44px; font-weight: 800; letter-spacing: -0.03em; }
  .ah-hero .ah-hero__text { margin: 0; max-width: 520px; font-size: 18px; line-height: 28px; }
  .ah-hero__actions { display: flex; flex-direction: column; align-self: stretch; gap: calc(var(--ah-space-2) * 1.5); margin-top: var(--ah-space-2); }
  .ah-hero__media { position: relative; overflow: hidden; aspect-ratio: 20 / 17; border-radius: var(--ah-radius-md); background: var(--ah-surface-100); }
  .ah-hero__media img { display: block; width: 100%; height: 100%; object-fit: cover; }

  @media (min-width: 750px) {
    .ah-hero { padding-top: var(--ah-space-12); }
    .ah-hero__panel { grid-template-columns: 1.1fr 1fr; gap: var(--ah-space-12); padding: calc(var(--ah-space-4) * 4); }
    .ah-hero__leaf { right: -120px; top: -140px; width: 420px; height: 420px; }
    .ah-hero__content { gap: var(--ah-space-6); }
    .ah-hero .ah-hero__heading { font-size: 56px; line-height: 60px; }
    .ah-hero__actions { flex-direction: row; flex-wrap: wrap; align-self: flex-start; margin-top: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AH Hero",
  "tag": "div",
  "class": "ah-section-hero",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Panel colour scheme",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "show_leaf",
      "label": "Show leaf motif",
      "default": true
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "Made with natural ingredients"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Plant-powered clean for every corner of your home."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Handwash, dishwash and floor cleaners made with neem, tulsi, aloe vera and citrus. Every ingredient is on the label."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "At least 1200 × 1020 px. Bright daylight, white or pale green background."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Describe the image for screen readers. Leave blank to use the alt text saved with the image."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button label",
      "default": "Shop handwash"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Shop all products"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "AH Hero"
    }
  ]
}
{% endschema %}
