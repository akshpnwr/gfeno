<section{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %} class="ah-root ah-section ah-scheme color-{{ section.settings.color_scheme }} ah-plants"{% if section.settings.heading != blank %} aria-labelledby="ah-plants-heading-{{ section.id }}"{% endif %}>
  <div class="ah-container">
    {%- capture heading_id -%}ah-plants-heading-{{ section.id }}{%- endcapture -%}
    {%- render 'ah-section-head',
      heading: section.settings.heading,
      heading_id: heading_id,
      link_label: section.settings.link_label,
      link_url: section.settings.link_url
    -%}
    <ul class="ah-plants__list" role="list">
      {%- for block in section.blocks -%}
        <li class="ah-plants__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <span class="ah-plants__icon">{% render 'ah-icon', icon: block.settings.icon %}</span>
          {%- endif -%}
          <h3 class="ah-plants__name">{{ block.settings.name | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="ah-plants__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .ah-plants__list { display: grid; grid-template-columns: 1fr; gap: var(--ah-space-4); margin: 0; padding: 0; list-style: none; }
  .ah-plants__item { display: flex; flex-direction: column; gap: var(--ah-space-3); padding: var(--ah-space-4); border-radius: var(--ah-radius-md); background: var(--ah-surface-200); }
  .ah-plants__icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: var(--ah-radius-pill); background: var(--ah-leaf-tint); color: var(--ah-brand); }
  .ah-plants__icon svg { width: 22px; height: 22px; }
  .ah-plants__name { margin: 0; font: var(--ah-text-heading-3); letter-spacing: 0; color: var(--ah-ink); }
  .ah-plants__text { margin: 0; font: var(--ah-text-small); color: var(--ah-ink-muted); }

  @media (min-width: 750px) {
    .ah-plants__list { grid-template-columns: repeat(3, 1fr); gap: var(--ah-space-6); }
    .ah-plants__item { padding: var(--ah-space-6); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AH Ingredient grid",
  "tag": "div",
  "class": "ah-section-ingredient-grid",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The plants we work with"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "info": "The link shows only when it has both a label and a URL.",
      "default": "See all ingredients"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Lets a menu link jump to this section, for example /pages/our-story#ingredients.",
      "default": "ingredients"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "leaf",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "drop", "label": "Drop" },
            { "value": "citrus", "label": "Citrus" },
            { "value": "none", "label": "None" }
          ]
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Neem"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AH Ingredient grid",
      "blocks": [
        { "type": "ingredient", "settings": { "icon": "leaf", "name": "Neem", "text": "In our handwash and floor cleaner, for a clean herbal freshness." } },
        { "type": "ingredient", "settings": { "icon": "leaf", "name": "Tulsi", "text": "Holy basil, paired with neem in our handwash." } },
        { "type": "ingredient", "settings": { "icon": "leaf", "name": "Aloe vera", "text": "Added so hands feel soft after washing." } },
        { "type": "ingredient", "settings": { "icon": "drop", "name": "Reetha", "text": "Soapnut, a plant cleanser that lathers on its own." } },
        { "type": "ingredient", "settings": { "icon": "citrus", "name": "Lemon", "text": "Helps lift grease off dishes." } },
        { "type": "ingredient", "settings": { "icon": "leaf", "name": "Lemongrass", "text": "Leaves floors smelling fresh." } }
      ]
    }
  ]
}
{% endschema %}
