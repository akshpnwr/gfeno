{%- liquid
  assign field_label = section.settings.label
  if field_label == blank
    assign field_label = 'newsletter.label' | t
  endif
  assign button_label = section.settings.button_label
  if button_label == blank
    assign button_label = 'newsletter.button_label' | t
  endif
-%}
<section class="ah-root ah-section ah-section--end ah-newsletter"{% if section.settings.heading != blank %} aria-labelledby="ah-nl-heading-{{ section.id }}"{% endif %}>
  <div class="ah-container ah-newsletter__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="ah-heading ah-heading--section" id="ah-nl-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="ah-body">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- assign form_id = 'AhNewsletter-' | append: section.id -%}
    {%- form 'customer', id: form_id, class: 'ah-newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="ah-newsletter__field">
        <label class="ah-newsletter__label" for="AhNewsletterEmail-{{ section.id }}">
          {{- field_label | escape -}}
        </label>
        <input
          id="AhNewsletterEmail-{{ section.id }}"
          class="ah-newsletter__input"
          type="email"
          name="contact[email]"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
          {% if section.settings.placeholder != blank %}placeholder="{{ section.settings.placeholder | escape }}"{% endif %}
          {% if form.errors %}
            aria-invalid="true" aria-describedby="AhNewsletterError-{{ section.id }}"
          {% elsif form.posted_successfully? %}
            aria-describedby="AhNewsletterSuccess-{{ section.id }}"
          {% endif %}
        >
      </div>
      <button type="submit" class="ah-btn ah-btn--primary" name="commit">
        {{- button_label | escape -}}
      </button>
      {%- if form.errors -%}
        <p class="ah-newsletter__message ah-newsletter__message--error" id="AhNewsletterError-{{ section.id }}" role="alert">
          {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
        </p>
      {%- elsif form.posted_successfully? -%}
        <p class="ah-newsletter__message" id="AhNewsletterSuccess-{{ section.id }}" role="status" tabindex="-1" autofocus>
          {{- 'newsletter.success' | t -}}
        </p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% stylesheet %}
  .ah-newsletter__inner { max-width: 760px; display: flex; flex-direction: column; align-items: center; gap: var(--ah-space-4); text-align: center; }
  .ah-newsletter__inner > .ah-body { margin: 0; }
  .ah-newsletter__form { display: flex; flex-direction: column; gap: calc(var(--ah-space-2) * 1.5); width: 100%; max-width: 520px; text-align: left; }
  .ah-newsletter__field { display: flex; flex-direction: column; gap: 6px; }
  .ah-newsletter__label { font: 700 14px/20px var(--ah-font-sans); color: var(--ah-ink); }
  .ah-newsletter__input {
    min-height: 48px;
    padding: 0 var(--ah-space-4);
    border: 1px solid var(--ah-ink-muted);
    border-radius: var(--ah-radius-sm);
    background: var(--ah-surface-100);
    color: var(--ah-ink);
    font: 400 16px/24px var(--ah-font-sans);
  }
  .ah-newsletter__input[aria-invalid="true"] { border-color: var(--ah-danger); }
  .ah-newsletter__message { flex-basis: 100%; margin: 0; font: 500 14px/20px var(--ah-font-sans); color: var(--ah-brand); }
  .ah-newsletter__message--error { color: var(--ah-danger); }

  @media (min-width: 750px) {
    .ah-newsletter__form { flex-direction: row; flex-wrap: wrap; align-items: flex-end; }
    .ah-newsletter__field { flex: 1 1 260px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AH Newsletter",
  "tag": "div",
  "class": "ah-section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 10% off your first order"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Join the list for new launches and refill offers. No spam."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Field label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Field placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "AH Newsletter"
    }
  ]
}
{% endschema %}
