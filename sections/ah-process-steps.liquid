<section class="ah-root ah-section ah-section--band ah-scheme color-{{ section.settings.color_scheme }} ah-steps"{% if section.settings.heading != blank %} aria-labelledby="ah-steps-heading-{{ section.id }}"{% endif %}>
  <div class="ah-container">
    {%- capture heading_id -%}ah-steps-heading-{{ section.id }}{%- endcapture -%}
    {%- render 'ah-section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, heading_id: heading_id -%}
    <ol class="ah-steps__list" role="list">
      {%- for block in section.blocks -%}
        <li class="ah-steps__item" {{ block.shopify_attributes }}>
          <span class="ah-steps__number">{{ forloop.index }}</span>
          <h3 class="ah-steps__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="ah-steps__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% stylesheet %}
  .ah-steps__list { display: grid; grid-template-columns: 1fr; gap: var(--ah-space-4); margin: 0; padding: 0; list-style: none; }
  .ah-steps__item { display: flex; flex-direction: column; gap: var(--ah-space-3); padding: var(--ah-space-4); border-radius: var(--ah-radius-md); background: var(--ah-surface-100); }
  .ah-steps__number { display: grid; place-items: center; width: 48px; height: 48px; border-radius: var(--ah-radius-pill); background: var(--ah-brand); color: var(--ah-surface-100); font: 800 20px/28px var(--ah-font-sans); }
  .ah-steps__title { margin: 0; font: var(--ah-text-heading-3); letter-spacing: 0; color: var(--ah-ink); }
  .ah-steps__text { margin: 0; font: var(--ah-text-body); color: var(--ah-ink-muted); }

  @media (min-width: 750px) {
    .ah-steps__list { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--ah-space-6); }
    .ah-steps__item { padding: var(--ah-space-6); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AH Process steps",
  "tag": "div",
  "class": "ah-section-process-steps",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How we make it"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From plant to bottle"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "info": "Name a test or certification only if it has been done."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AH Process steps",
      "blocks": [
        { "type": "step", "settings": { "title": "Pick the plant", "text": "Each product starts with one hero ingredient: neem for hands, lemon for dishes, lemongrass for floors." } },
        { "type": "step", "settings": { "title": "Build the formula" } },
        { "type": "step", "settings": { "title": "Check every batch" } },
        { "type": "step", "settings": { "title": "Fill, ship, refill", "text": "Bottled, labelled and delivered across India, with refill packs for when you run out." } }
      ]
    }
  ]
}
{% endschema %}
