<section class="ah-root ah-section ah-section--band ah-scheme color-{{ section.settings.color_scheme }} ah-reviews"{% if section.settings.heading != blank %} aria-labelledby="ah-reviews-heading-{{ section.id }}"{% endif %}>
  <div class="ah-container">
    {%- assign heading_id = 'ah-reviews-heading-' | append: section.id -%}
    {%- render 'ah-section-head',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      heading_id: heading_id
    -%}
    <ul class="ah-reviews__list" role="list">
      {%- for block in section.blocks -%}
        <li class="ah-reviews__item" {{ block.shopify_attributes }}>
          <figure class="ah-quote ah-reviews__quote">
            {%- if block.settings.rating > 0 -%}
              <div class="ah-reviews__stars">
                {%- render 'ah-rating-stars', rating: block.settings.rating, max: 5, size: '18px' -%}
              </div>
            {%- endif -%}
            <blockquote class="ah-quote__text ah-reviews__text">
              <p>{{ block.settings.quote | escape }}</p>
            </blockquote>
            {%- if block.settings.name != blank or block.settings.product != blank -%}
              <figcaption class="ah-quote__meta">
                {{- block.settings.name | escape -}}
                {%- if block.settings.location != blank -%}, {{ block.settings.location | escape }}{%- endif -%}
                {%- if block.settings.product != blank -%}
                  {%- if block.settings.name != blank %} · {% endif -%}
                  {{- block.settings.product | escape -}}
                {%- endif -%}
              </figcaption>
            {%- endif -%}
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .ah-reviews__list {
    display: flex;
    gap: var(--ah-space-4);
    margin: 0 calc(var(--ah-space-4) * -1);
    padding: 0 var(--ah-space-4) var(--ah-space-2);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 var(--ah-space-4);
    scrollbar-width: none;
  }
  .ah-reviews__list::-webkit-scrollbar { display: none; }
  .ah-reviews__item { flex: 0 0 85%; scroll-snap-align: start; }
  .ah-reviews .ah-reviews__quote { height: 100%; gap: var(--ah-space-4); border-color: transparent; }
  .ah-reviews__stars { line-height: 0; }
  .ah-reviews .ah-reviews__text { padding: 0; border: 0; font: 400 16px/24px var(--ah-font-sans); font-style: normal; color: var(--ah-ink); }
  .ah-reviews .ah-reviews__text p { margin: 0; }
  .ah-reviews .ah-reviews__text p::before { content: open-quote; }
  .ah-reviews .ah-reviews__text p::after { content: close-quote; }

  @media (min-width: 750px) {
    .ah-reviews__list { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--ah-space-6); margin: 0; padding: 0; overflow: visible; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AH Testimonials",
  "tag": "div",
  "class": "ah-section-testimonials",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What customers say"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "info": "0 hides the stars.",
          "min": 0,
          "max": 5,
          "step": 0.5,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "info": "Real, verified reviews only. 1–2 sentences, about 160 characters.",
          "default": "The neem handwash smells fresh and my hands don’t feel dry, even after washing many times a day."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "info": "First name and last initial.",
          "default": "Priya S."
        },
        {
          "type": "text",
          "id": "location",
          "label": "City",
          "default": "Pune"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product reviewed",
          "default": "Neem & Tulsi Handwash"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AH Testimonials",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
